{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SyntaxParser Tokens",
  "scopeName": "source.syntaxparser.tokens",
  "patterns": [
    { "include": "#comment" },
    { "include": "#definition" },
    { "include": "#regex" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.syntaxparser"
    },
    "definition": {
      "comment": "Token name at the start of a line, optionally prefixed with '!' (skip token), followed by '='.",
      "match": "^(\\s*)(!)?([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
      "captures": {
        "2": { "name": "keyword.operator.skip.syntaxparser" },
        "3": { "name": "entity.name.type.token.syntaxparser" },
        "4": { "name": "keyword.operator.assignment.syntaxparser" }
      }
    },
    "regex": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#char-class" },
        { "include": "#escape" },
        { "include": "#regex-operator" }
      ]
    },
    "string": {
      "name": "string.quoted.single.syntaxparser",
      "begin": "'",
      "end": "'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.syntaxparser" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.syntaxparser" } },
      "patterns": [
        { "include": "#escape" }
      ]
    },
    "char-class": {
      "name": "constant.other.character-class.set.syntaxparser",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.definition.character-class.begin.syntaxparser" } },
      "endCaptures": { "0": { "name": "punctuation.definition.character-class.end.syntaxparser" } },
      "patterns": [
        { "match": "-", "name": "punctuation.separator.character-class.range.syntaxparser" },
        { "include": "#escape" }
      ]
    },
    "escape": {
      "comment": "Backslash escapes: \\n \\t plus meta classes \\T (any) etc.",
      "match": "\\\\.",
      "name": "constant.character.escape.syntaxparser"
    },
    "regex-operator": {
      "match": "[|*+?()]",
      "name": "keyword.operator.regex.syntaxparser"
    }
  }
}
